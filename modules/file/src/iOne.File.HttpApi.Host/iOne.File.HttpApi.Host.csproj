<Project Sdk="Microsoft.NET.Sdk.Web">
  <Import Project="..\..\..\..\common.props" />
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AspNetCoreHostingModel>InProcess</AspNetCoreHostingModel>
    <RootNamespace>iOne.File</RootNamespace>
    <PreserveCompilationReferences>true</PreserveCompilationReferences>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(RunConfiguration)' == 'iOne.File.HttpApi.Host' " />
  <ItemGroup>
    <PackageReference Include="AspNetCore.HealthChecks.UI" Version="9.0.0" />
    <PackageReference Include="AspNetCore.HealthChecks.UI.Client" Version="9.0.0" />
    <PackageReference Include="AspNetCore.HealthChecks.UI.InMemory.Storage" Version="9.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="9.0.5" />
    <PackageReference Include="Serilog.AspNetCore" Version="9.0.0" />
    <PackageReference Include="Serilog.Sinks.Async" Version="2.1.0" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Volo.Abp.AspNetCore.MultiTenancy" Version="9.3.6" />
    <PackageReference Include="Volo.Abp.Autofac" Version="9.3.6" />
    <PackageReference Include="Volo.Abp.AspNetCore.Serilog" Version="9.3.6" />
    <PackageReference Include="Volo.Abp.Swashbuckle" Version="9.3.6" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\Volo.Abp.Account\src\Volo.Abp.Account.Web.OpenIddict\Volo.Abp.Account.Web.OpenIddict.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Volo.Abp.AspNetCore.Mvc.UI.Theme.LeptonXLite" Version="4.3.6" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\iOne.File.Application\iOne.File.Application.csproj" />
    <ProjectReference Include="..\iOne.File.HttpApi\iOne.File.HttpApi.csproj" />
    <ProjectReference Include="..\..\..\..\src\common\infra\iOne.EntityFrameworkCore\iOne.EntityFrameworkCore.csproj" />
    <ProjectReference Include="..\..\..\Volo.Abp.AuditLogging\src\Volo.Abp.AuditLogging.HttpApi\Volo.Abp.AuditLogging.HttpApi.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Volo.Abp.Studio.Client.AspNetCore" Version="1.4.2" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="Logs\**" />
    <Content Remove="Logs\**" />
    <EmbeddedResource Remove="Logs\**" />
    <None Remove="Logs\**" />
  </ItemGroup>

  <!-- ABP LeptonX error/account pages bundle /libs/abp/... from wwwroot. Microservice hosts do not run abp install-libs separately; copy from main HttpApi.Host after install-libs (see README). -->
  <Target Name="CopyAbpClientLibsFromMainHost" BeforeTargets="BeforeBuild">
    <PropertyGroup>
      <_MainHostLibs>$(MSBuildThisFileDirectory)..\..\..\..\src\web\iOne.HttpApi.Host\wwwroot\libs</_MainHostLibs>
      <_LocalLibs>$(MSBuildThisFileDirectory)wwwroot\libs</_LocalLibs>
    </PropertyGroup>
    <ItemGroup>
      <_LibFile Include="$(_MainHostLibs)\**\*.*" Condition="Exists('$(_MainHostLibs)')" />
    </ItemGroup>
    <MakeDir Directories="$(_LocalLibs)" Condition="Exists('$(_MainHostLibs)')" />
    <Copy
      SourceFiles="@(_LibFile)"
      DestinationFiles="$(_LocalLibs)\%(_LibFile.RecursiveDir)%(_LibFile.Filename)%(_LibFile.Extension)"
      SkipUnchangedFiles="true"
      Condition="Exists('$(_MainHostLibs)')" />
    <Warning
      Text="wwwroot/libs not found on main host at $(_MainHostLibs). Run 'abp install-libs' from the solution root (README), then rebuild this project."
      Condition="!Exists('$(_MainHostLibs)')" />
  </Target>
</Project>

