{
    "name": "sakai-ng",
    "version": "20.0.0",
    "scripts": {
        "ng": "ng",
        "start": "ng serve",
        "build": "ng build",
        "watch": "ng build --watch --configuration development",
        "format": "prettier --write \"**/*.{js,mjs,ts,mts,d.ts,html}\" --cache",
        "test": "ng test",
        "generate-proxy": "abp generate-proxy -t ng -u https://localhost:44360 -m abp",
        "generate-proxy:audit-logging": "abp generate-proxy -t ng -u https://localhost:44360 -m audit-logging",
        "generate-proxy:module": "node scripts/generate-proxy-module.js",
        "generate-proxy:complete": "npm run generate-proxy && npm run generate-proxy:audit-logging && node scripts/generate-missing-dtos.js",
        "generate-proxy:all": "node scripts/generate-proxy-all.js",
        "fix-proxy-patches": "node scripts/fix-claim-proxy.js && node scripts/fix-product-proxy-models.js && node scripts/fix-microsoft-mvc-iaction-result.js",
        "prestart": "node scripts/fix-claim-proxy.js && node scripts/fix-product-proxy-models.js && node scripts/fix-microsoft-mvc-iaction-result.js",
        "fix-proxy-dtos": "node scripts/generate-missing-dtos.js && node scripts/generate-missing-services.js && node scripts/fix-enum-imports.js && node scripts/fix-string-values.js",
        "fix-proxy-services": "node scripts/generate-missing-services.js"
    },
    "private": true,
    "dependencies": {
        "@abp/ng.account": "~9.3.6",
        "@abp/ng.core": "~9.3.6",
        "@abp/ng.oauth": "~9.3.6",
        "@angular/animations": "^20",
        "@angular/cdk": "^20.2.14",
        "@angular/common": "^20",
        "@angular/compiler": "^20",
        "@angular/core": "^20",
        "@angular/forms": "^20",
        "@angular/platform-browser": "^20",
        "@angular/platform-browser-dynamic": "^20",
        "@angular/router": "^20",
        "@fortawesome/fontawesome-free": "^7.2.0",
        "@microsoft/signalr": "^8.0.17",
        "@ngx-validate/core": "^0.2.0",
        "@primeuix/themes": "^1.2.1",
        "@tailwindcss/postcss": "^4.1.11",
        "chart.js": "4.4.2",
        "file-saver": "^2.0.5",
        "primeclt": "^0.1.5",
        "primeicons": "^7.0.0",
        "primeng": "^20",
        "rxjs": "~7.8.2",
        "tailwindcss-primeui": "^0.6.1",
        "tslib": "^2.8.1",
        "xlsx-js-style": "^1.2.0",
        "zone.js": "~0.15.1"
    },
    "devDependencies": {
        "@abp/ng.schematics": "~9.3.6",
        "@angular-devkit/build-angular": "^20",
        "@angular/cli": "^20",
        "@angular/compiler-cli": "^20",
        "@types/file-saver": "^2.0.7",
        "@types/jasmine": "~5.1.0",
        "autoprefixer": "^10.4.20",
        "eslint": "^9.30.1",
        "eslint-config-prettier": "^10.1.5",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-prefer-arrow": "^1.2.3",
        "eslint-plugin-prettier": "^5.5.1",
        "jasmine-core": "~5.8.0",
        "karma": "~6.4.4",
        "karma-chrome-launcher": "~3.2.0",
        "karma-coverage": "~2.2.1",
        "karma-jasmine": "~5.1.0",
        "karma-jasmine-html-reporter": "~2.1.0",
        "postcss": "^8.5.6",
        "prettier": "^3.6.2",
        "tailwindcss": "^4.1.11",
        "typescript": "~5.8.3"
    }
}
